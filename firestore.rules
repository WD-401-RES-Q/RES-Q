rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Public reads for login lookup; lock writes to authenticated users only.
    match /admins/{docId} {
      allow read: if true;
      allow write: if false; // Only allow writes through admin scripts - not from client
    }

    match /semi_admins/{docId} {
      allow read: if true;
      allow write: if true; // Allow writes for app initialization/seeding
    }

    match /users/{docId} {
      allow read: if true; // needed for username/password lookup during login
      allow write: if request.auth != null && request.auth.uid == docId;
    }

    match /pending_users/{docId} {
      allow read, write: if true; // temporarily open for debugging
    }

    match /approved_users/{docId} {
      allow read, write: if true; // allow admin to approve users
    }

    match /reports/{docId} {
      allow read: if true; // allow reading reports
      allow create: if true; // allow anyone to create reports
      allow update: if true; // allow updating reports (including comment count)
      allow delete: if false; // prevent deletions

      // Nested comments subcollection
      match /comments/{commentId} {
        allow read: if true; // allow anyone to read comments
        allow create: if true; // allow anyone to post comments
        allow update: if true; // allow updating comment votes
        allow delete: if false; // prevent comment deletion
      }

      // Nested admin comments subcollection
      match /adminComments/{commentId} {
        allow read: if true;
        allow create: if true;
        allow update: if true;
        allow delete: if false;
      }
    }

    // Root-level comments collection (fallback)
    match /comments/{commentId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if false;
    }

    // Fallback deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
