rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Public reads for login lookup; lock writes to authenticated users only.
    match /admins/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /semi_admins/{docId} {
      allow read: if true;
      allow write: if true; // Allow writes for app initialization/seeding
    }

    match /users/{docId} {
      allow read: if true; // needed for username/password lookup during login
      allow write: if request.auth != null && request.auth.uid == docId;
    }

    match /pending_users/{docId} {
      allow read, write: if true; // temporarily open for debugging
    }

    match /approved_users/{docId} {
      allow read, write: if true; // allow admin to approve users
    }

    // Fallback deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}