rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user owns the document
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isValidUserVotes() {
      return request.resource.data.keys().hasOnly(['votes']) &&
          request.resource.data.votes is map &&
          request.resource.data.votes.size() > 0 && // Prevent empty votes
          request.resource.data.votes.values().hasOnly(['green', 'red', 'none']);
    }

    // Helper function to validate vote record data
    function isValidVoteRecord() {
      return request.resource.data.keys().hasOnly(['reportDocId', 'reportId', 'reportTitle', 'userPhone', 'voteType', 'timestamp']) &&
          request.resource.data.voteType in ['green', 'red', 'none'] &&
          request.resource.data.userPhone is string &&
          request.resource.data.userPhone.matches('^[0-9]+$');  // Validate phone number format
    }

    // Semi-admin presence updates (online/offline heartbeat)
    function isValidSemiAdminPresenceUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'isLoggedIn',
            'status',
            'isAvailable',
            'lastSeenAt',
            'lastLoginAt',
            'sessionStartedAt'
          ]) &&
          request.resource.data.isLoggedIn is bool &&
          request.resource.data.isAvailable is bool &&
          request.resource.data.status in ['online', 'offline', 'available', 'unavailable', 'busy'];
    }

    // Basic comment payload checks for authored content
    function isValidCommentCreate() {
      return request.resource.data.author is string &&
          request.resource.data.author.size() > 0 &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 256 &&
          request.resource.data.timestamp is timestamp;
    }

    // Basic reply payload checks for authored content
    function isValidReplyCreate() {
      return request.resource.data.author is string &&
          request.resource.data.author.size() > 0 &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 256 &&
          request.resource.data.timestamp is timestamp &&
          request.resource.data.parentCommentId is string &&
          request.resource.data.parentCommentId.size() > 0;
    }

    // Admins collection - open read for admin login (no Firebase Auth)
    match /admins/{docId} {
      allow read: if true;
      // Allow update for password migration (hash + salt)
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['passwordHash', 'passwordSalt', 'password']);
      allow create, delete: if false; // Only backend admin scripts
    }

    // Semi-admins collection - allow read for mobile login checks
    match /semi_admins/{docId} {
      allow read: if true;
      allow update: if isValidSemiAdminPresenceUpdate();
      allow create, delete: if false; // Only backend scripts
    }

    // Users collection - authenticated users can only read/write their own
    match /users/{docId} {
      allow read: if isAuthenticated() && (isOwner(docId) || request.auth.token.admin == true);
      allow create: if isAuthenticated() && isOwner(docId);
      allow update: if isOwner(docId);
      allow delete: if false; // Prevent user self-deletion
    }

    // Pending users - allow read/create for mobile registration + login checks
    match /pending_users/{docId} {
      allow read: if true;
      allow create: if true;
      allow update: if false;
      allow delete: if true;
    }

    // Approved users - allow read for mobile login checks
    match /approved_users/{docId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true; // Allow admin to permanently ban (delete) users
    }

    // Announcements - readable by all, writable by all
    match /announcements/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Reports collection
    match /reports/{docId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if false;

      // Nested comments subcollection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isValidCommentCreate();
        allow update: if isAuthenticated();
        allow delete: if false;

        // Nested replies under report comments
        match /replies/{replyId} {
          allow read: if true;
          allow create: if isValidReplyCreate();
          allow update: if isAuthenticated();
          allow delete: if false;
        }
      }
    }

    // FCM token registry for push notifications
    // NOTE: userId is app-level (phone/docId), not Firebase Auth uid.
    match /user_tokens/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if false;
    }

    // User votes (verify/report selections per user)
    // Using phone number as document ID for easier tracking
    match /userVotes/{phoneNumber} {
      allow read: if request.auth != null;
      
      // Allow users to create/update only their own votes
      // ⚠️ Performance Note: The get() call adds ~100ms latency and doubles read quota.
      // This is acceptable for current scale. Monitor costs as user base grows.
      // Future optimization: Consider using Custom Claims to store phone number in auth token.
      allow create, update: if request.auth != null && 
        isValidUserVotes() &&
        phoneNumber.matches('^[0-9]+$') &&
        // Verify the authenticated user owns this phone number
        phoneNumber == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.contactNumber;
      
      allow delete: if false;
    }

    // Vote records for tracking individual votes
    match /voteRecords/{recordId} {
      // Allow authenticated users to read vote records
      allow read: if request.auth != null;
      
      // Allow creating vote records with validation
      allow create: if request.auth != null && isValidVoteRecord();
      
      // Vote records are immutable once created
      allow update: if false;
      allow delete: if false;
    }

    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
