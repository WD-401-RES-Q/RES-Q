rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user owns the document
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isValidVoteSelectionMap(voteMap) {
      return voteMap is map &&
          voteMap.values().hasOnly(['green', 'red', 'none']);
    }

    function isValidUserVotesWrite() {
      return request.resource.data.keys().hasOnly(['votes', 'commentVotes']) &&
          (!request.resource.data.keys().hasAny(['votes']) ||
            isValidVoteSelectionMap(request.resource.data.votes)) &&
          (!request.resource.data.keys().hasAny(['commentVotes']) ||
            isValidVoteSelectionMap(request.resource.data.commentVotes));
    }

    // Helper function to validate vote record data
    function isValidVoteRecord() {
      return request.resource.data.keys().hasOnly(['reportDocId', 'reportId', 'reportTitle', 'userPhone', 'voteType', 'timestamp']) &&
          request.resource.data.voteType in ['green', 'red', 'none'] &&
          request.resource.data.userPhone is string &&
          request.resource.data.userPhone.matches('^[0-9]+$');  // Validate phone number format
    }

    // Responder presence updates (online/offline heartbeat)
    function isValidResponderPresenceUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'isLoggedIn',
            'status',
            'isAvailable',
            'lastSeenAt',
            'lastLoginAt',
            'sessionStartedAt'
          ]) &&
          request.resource.data.isLoggedIn is bool &&
          request.resource.data.isAvailable is bool &&
          request.resource.data.status in ['online', 'offline', 'available', 'unavailable', 'busy'];
    }

    // Responder first-time PIN setup update.
    function isValidResponderPinSetupUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly([
            'pin_hash',
            'hashedPin',
            'pin',
            'hasPinCreated',
            'pinSetAt',
            'updatedAt'
          ]) &&
          request.resource.data.pin_hash is string &&
          request.resource.data.pin_hash.matches('^[a-fA-F0-9]{64}$') &&
          request.resource.data.hashedPin is string &&
          request.resource.data.hashedPin.matches('^[a-fA-F0-9]{64}$') &&
          request.resource.data.hasPinCreated == true &&
          request.resource.data.pinSetAt is timestamp &&
          request.resource.data.updatedAt is timestamp &&
          (!request.resource.data.keys().hasAny(['pin']) ||
            (request.resource.data.pin is string &&
              request.resource.data.pin.matches('^[0-9]{4}$')));
    }

    // Responder account creation from admin web page.
    function isValidResponderCreate() {
      let keys = request.resource.data.keys();
      return keys.hasOnly([
          'fullName',
          'name',
          'username',
          'role',
          'contactNumber',
          'phoneNumber',
          'pin',
          'password',
          'isLoggedIn',
          'status',
          'isAvailable',
          'createdAt'
        ]) &&
        request.resource.data.fullName is string &&
        request.resource.data.fullName.size() > 1 &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 1 &&
        request.resource.data.username is string &&
        request.resource.data.username.size() > 2 &&
        request.resource.data.role is string &&
        request.resource.data.contactNumber is string &&
        request.resource.data.contactNumber.matches('^\\+639[0-9]{9}$') &&
        request.resource.data.phoneNumber is string &&
        request.resource.data.phoneNumber.matches('^\\+639[0-9]{9}$') &&
        request.resource.data.pin is string &&
        request.resource.data.pin.matches('^[0-9]{4}$') &&
        request.resource.data.password is string &&
        request.resource.data.password.size() >= 6 &&
        request.resource.data.isLoggedIn is bool &&
        request.resource.data.isAvailable is bool &&
        request.resource.data.status in ['online', 'offline', 'available', 'unavailable', 'busy'] &&
        (!keys.hasAny(['createdAt']) || request.resource.data.createdAt is timestamp);
    }

    // Basic comment payload checks for authored content
    function isValidCommentCreate() {
      return request.resource.data.author is string &&
          request.resource.data.author.size() > 0 &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 256 &&
          request.resource.data.timestamp is timestamp;
    }

    // User-authored mobile comments (app login is not Firebase Auth-based).
    function isValidUserCommentCreate() {
      return isValidCommentCreate() &&
          request.resource.data.type == 'user';
    }

    // Responder comments from responder flow may not have Firebase Auth session.
    // Allow only responder/admin-typed comment payloads.
    function isValidResponderCommentCreate() {
      return request.resource.data.author is string &&
          request.resource.data.author.size() > 0 &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 256 &&
          request.resource.data.timestamp is timestamp &&
          request.resource.data.role == 'responder' &&
          request.resource.data.type == 'admin';
    }

    // Basic reply payload checks for authored content
    function isValidReplyCreate() {
      return request.resource.data.author is string &&
          request.resource.data.author.size() > 0 &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 256 &&
          request.resource.data.timestamp is timestamp &&
          request.resource.data.parentCommentId is string &&
          request.resource.data.parentCommentId.size() > 0;
    }

    // Biometrics/user preference payload checks.
    function isValidUserPreferenceWrite() {
      return request.resource.data.keys().hasOnly([
          'biometricsEnabled',
          'biometricsUpdatedAt'
        ]) &&
        request.resource.data.biometricsEnabled is bool &&
        (!request.resource.data.keys().hasAny(['biometricsUpdatedAt']) ||
          request.resource.data.biometricsUpdatedAt is timestamp);
    }

    // User-authored mobile replies (app login is not Firebase Auth-based).
    function isValidUserReplyCreate() {
      return isValidReplyCreate() &&
          request.resource.data.type == 'user_reply';
    }

    // Allow only interaction counters to change for public (non-auth) updates.
    function isValidCommentInteractionUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['greenFlags', 'redFlags', 'replyCount']) &&
          (!changed.hasAny(['greenFlags']) ||
            (request.resource.data.greenFlags is int &&
              request.resource.data.greenFlags >= 0)) &&
          (!changed.hasAny(['redFlags']) ||
            (request.resource.data.redFlags is int &&
              request.resource.data.redFlags >= 0)) &&
          (!changed.hasAny(['replyCount']) ||
            (request.resource.data.replyCount is int &&
              request.resource.data.replyCount >= 0));
    }

    // Admins collection - open read for admin login (no Firebase Auth)
    match /admins/{docId} {
      allow read: if true;
      // Allow update for password migration (hash + salt)
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['passwordHash', 'passwordSalt', 'password']);
      allow create, delete: if false; // Only backend admin scripts
    }

    // Responders collection - allow read for mobile login checks
    match /responders/{docId} {
      allow read: if true;
      allow create: if isValidResponderCreate();
      allow update: if isValidResponderPresenceUpdate() || isValidResponderPinSetupUpdate();
      allow delete: if false; // Only backend scripts
    }

    // Users collection - authenticated users can only read/write their own
    match /users/{docId} {
      allow read: if isAuthenticated() && (isOwner(docId) || request.auth.token.admin == true);
      allow create: if isAuthenticated() && isOwner(docId);
      allow update: if isOwner(docId);
      allow delete: if false; // Prevent user self-deletion
    }

    // Pending users - allow read/create for mobile registration + login checks
    match /pending_users/{docId} {
      allow read: if true;
      allow create: if true;
      allow update: if false;
      allow delete: if true;
    }

    // Approved users - allow read for mobile login checks
    match /approved_users/{docId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true; // Allow admin to permanently ban (delete) users
    }

    // User preferences (biometrics and per-user app settings)
    match /userPreferences/{docId} {
      allow read: if true;
      allow create, update: if isValidUserPreferenceWrite();
      allow delete: if false;
    }

    // Announcements - readable by all, writable by all
    match /announcements/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Reports collection
    match /reports/{docId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if false;

      // Nested comments subcollection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if (isAuthenticated() && isValidCommentCreate()) ||
          isValidResponderCommentCreate() ||
          isValidUserCommentCreate();
        allow update: if isAuthenticated() || isValidCommentInteractionUpdate();
        allow delete: if false;

        // Nested replies under report comments
        match /replies/{replyId} {
          allow read: if true;
          allow create: if (isAuthenticated() && isValidReplyCreate()) ||
            isValidUserReplyCreate();
          allow update: if isAuthenticated() || isValidCommentInteractionUpdate();
          allow delete: if false;
        }
      }
    }

    // User votes (verify/report selections per user)
    // Using phone number as document ID for easier tracking
    match /userVotes/{phoneNumber} {
      allow read: if true;
      
      // Allow users to create/update only their own votes
      // ⚠️ Performance Note: The get() call adds ~100ms latency and doubles read quota.
      // This is acceptable for current scale. Monitor costs as user base grows.
      // Future optimization: Consider using Custom Claims to store phone number in auth token.
      allow create, update: if phoneNumber.matches('^[0-9]+$') &&
        isValidUserVotesWrite();
      
      allow delete: if false;
    }

    // Vote records for tracking individual votes
    match /voteRecords/{recordId} {
      // Allow authenticated users to read vote records
      allow read: if true;
      
      // Allow creating vote records with validation
      allow create: if isValidVoteRecord();
      
      // Vote records are immutable once created
      allow update: if false;
      allow delete: if false;
    }

    // FCM tokens used by Cloud Functions to send device push notifications.
    match /user_tokens/{docId} {
      allow read: if false;
      allow create, update: if request.resource.data.fcmToken is string &&
        request.resource.data.fcmToken.size() > 20;
      allow delete: if true;
    }

    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
