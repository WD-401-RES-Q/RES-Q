rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow anyone to read ID photos (for admin verification)
    match /id_photos/{allPaths=**} {
      allow read: if true;
      // Allow unauthenticated writes for registration flow
      allow write: if true;
    }

    // Deny everything else by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
