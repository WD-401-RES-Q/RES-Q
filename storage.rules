rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow anyone to read ID photos (for admin verification)
    match /id_photos/{allPaths=**} {
      allow read: if true;
      // Allow unauthenticated writes for registration flow
      allow write: if true;
    }

    // Report media uploaded from the mobile app.
    // Requires an authenticated Firebase session (anonymous auth is used in-app).
    match /reports/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Deny everything else by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
